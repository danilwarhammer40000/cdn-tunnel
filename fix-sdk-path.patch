+                def props = new Properties()
+                lp.withInputStream { props.load(it) }
+                sdkDir = props.getProperty('sdk.dir')
+            }
+        }
+        if (!sdkDir && System.getenv('LOCALAPPDATA')) {
+            sdkDir = System.getenv('LOCALAPPDATA') + '\\Android\\Sdk' // стандартное место Android Studio на Windows
+        }
+        if (sdkDir) {
+            environment 'ANDROID_HOME', sdkDir.replace('\\', '/')
+            logger.lifecycle("buildGoBinaries: Android SDK = ${sdkDir}")
+        }
         logger.lifecycle("buildGoBinaries: bash = ${bashExecutable}")
         if (bashExecutable == 'bash' && org.gradle.internal.os.OperatingSystem.current().isWindows()) {
