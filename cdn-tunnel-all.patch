+func (e *e2eEnv) client() *tunnelClient {
+	hc := &http.Client{Transport: authRoundTripper{base: e.srv.Client().Transport, id: "test"}}
+	return &tunnelClient{base: e.srv.URL, pool: []*http.Client{hc}, udp: true}
+}
