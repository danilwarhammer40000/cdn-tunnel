+                    "Если сборка упадёт с 'Cannot run program \"bash\"' — значит, у вас нестандартная установка Git; " +
+                    "напишите, где стоит git.exe (where.exe git), подправим путь.")
+        }
+    }
+    commandLine bashExecutable, "${rootProject.projectDir}/build-go.sh"
     inputs.file "${rootProject.projectDir}/../main.go"
