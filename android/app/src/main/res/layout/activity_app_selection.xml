<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_all"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="52dp"
            android:maxLines="2" android:textSize="11sp"
            android:paddingStart="2dp" android:paddingEnd="2dp"
            android:insetTop="4dp" android:insetBottom="4dp"
            android:text="Все" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_only"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="52dp"
            android:maxLines="2" android:textSize="11sp"
            android:paddingStart="2dp" android:paddingEnd="2dp"
            android:insetTop="4dp" android:insetBottom="4dp"
            android:text="Только\nвыбранные" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_except"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="52dp"
            android:maxLines="2" android:textSize="11sp"
            android:paddingStart="2dp" android:paddingEnd="2dp"
            android:insetTop="4dp" android:insetBottom="4dp"
            android:text="Кроме\nвыбранных" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tv_mode_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="Через туннель идёт весь трафик устройства." />

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="Выбрано: 3" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Поиск по названию или пакету"
            android:inputType="text"
            android:visibility="visible" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_apps"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_apps"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:visibility="gone" />

</LinearLayout>
