+                doStart(pendingReconnectConfig);
+            } else {
+                Toast.makeText(this, "Переподключение отменено — примените список вручную кнопкой в приложении", Toast.LENGTH_LONG).show();
+            }
+            pendingReconnectConfig = null;
+            finish();
+        }
+    }
